<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 鼠标（实物抠图 · VGN F1 MOBA） ================= -->
    <DataTemplate x:Key="ArtMouse">
        <Image Source="/Assets/device-mouse.png" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </DataTemplate>

    <!-- ================= 雷蛇 旋风黑鲨 BlackShark V2 Pro（官方图抠图） ================= -->
    <DataTemplate x:Key="ArtRazerHeadset">
        <Image Source="/Assets/device-razer-headset.png" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </DataTemplate>

    <!-- ================= 通用鼠标（非 VGN 机型） ================= -->
    <DataTemplate x:Key="ArtMouseGeneric">
        <Viewbox Stretch="Uniform">
            <Canvas Width="200" Height="200">
                <Ellipse Canvas.Left="54" Canvas.Top="160" Width="92" Height="22" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2E3540" Offset="0" />
                            <GradientStop Color="#002E3540" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path Data="M100,24
                              C122,24 134,29 137,42
                              C140,58 142,80 142,104
                              C142,132 132,156 117,166
                              C110,171 104,173 100,173
                              C96,173 90,171 83,166
                              C68,156 58,132 58,104
                              C58,80 60,58 63,42
                              C66,29 78,24 100,24 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F7F8FA" Offset="0.45" />
                            <GradientStop Color="#E3E7EC" Offset="0.85" />
                            <GradientStop Color="#D2D7DE" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Stroke>
                        <SolidColorBrush Color="#C4CAD2" />
                    </Path.Stroke>
                    <Path.StrokeThickness>1.1</Path.StrokeThickness>
                </Path>

                <Path Data="M100,25 L100,72" Stroke="#C2C8D0" StrokeThickness="1.2" />
                <Path Data="M62,72 C80,78 120,78 138,72" Stroke="#C2C8D0" StrokeThickness="1.2" />

                <Rectangle Canvas.Left="92" Canvas.Top="34" Width="16" Height="36" RadiusX="8" RadiusY="8"
                           Fill="#F0F2F5" Stroke="#D3D8DE" StrokeThickness="0.9" />
                <Rectangle Canvas.Left="95" Canvas.Top="38" Width="10" Height="28" RadiusX="5" RadiusY="5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4E555E" Offset="0" />
                            <GradientStop Color="#22262B" Offset="0.5" />
                            <GradientStop Color="#434A52" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle Canvas.Left="95" Canvas.Top="80" Width="10" Height="11" RadiusX="3.4" RadiusY="3.4"
                           Fill="#EDF0F3" Stroke="#CCD2D9" StrokeThickness="0.9" />

                <Rectangle Canvas.Left="135" Canvas.Top="92" Width="7" Height="16" RadiusX="3.5" RadiusY="3.5"
                           Fill="#E8EBEF" Stroke="#C9CFD6" StrokeThickness="0.9" />
                <Rectangle Canvas.Left="135" Canvas.Top="112" Width="7" Height="12" RadiusX="3.5" RadiusY="3.5"
                           Fill="#E8EBEF" Stroke="#C9CFD6" StrokeThickness="0.9" />

                <Path Data="M100,26 C119,26 130,31 132,42 C126,36 115,33 100,33 C85,33 74,36 68,42
                              C70,31 81,26 100,26 Z" Opacity="0.8">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- ================= 键盘（俯视） ================= -->
    <DataTemplate x:Key="ArtKeyboard">
        <Viewbox Stretch="Uniform">
            <Canvas Width="200" Height="200">
                <Ellipse Canvas.Left="26" Canvas.Top="146" Width="148" Height="24" Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3A4250" Offset="0" />
                            <GradientStop Color="#003A4250" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Rectangle Canvas.Left="18" Canvas.Top="70" Width="164" Height="62" RadiusX="9" RadiusY="9">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#E9ECF0" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Stroke>
                        <SolidColorBrush Color="#CFD5DC" />
                    </Rectangle.Stroke>
                    <Rectangle.StrokeThickness>1.2</Rectangle.StrokeThickness>
                </Rectangle>

                <Rectangle Canvas.Left="23" Canvas.Top="75" Width="154" Height="40">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,11,10.2" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#FAFBFC">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0.8,0.8,9.3,8.4" RadiusX="2" RadiusY="2" />
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#D6DBE1" Thickness="0.9" />
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 空格 -->
                <Rectangle Canvas.Left="62" Canvas.Top="116" Width="76" Height="8.5" RadiusX="2.5" RadiusY="2.5"
                           Fill="#FAFBFC" Stroke="#D6DBE1" StrokeThickness="0.9" />
                <Rectangle Canvas.Left="23" Canvas.Top="116" Width="34" Height="8.5" RadiusX="2.5" RadiusY="2.5"
                           Fill="#FAFBFC" Stroke="#D6DBE1" StrokeThickness="0.9" />
                <Rectangle Canvas.Left="143" Canvas.Top="116" Width="34" Height="8.5" RadiusX="2.5" RadiusY="2.5"
                           Fill="#FAFBFC" Stroke="#D6DBE1" StrokeThickness="0.9" />

                <!-- 三颗点缀键帽 -->
                <Rectangle Canvas.Left="158" Canvas.Top="76" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="#F3B7B1" />
                <Rectangle Canvas.Left="147" Canvas.Top="76" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="#B9D9F3" />
                <Rectangle Canvas.Left="136" Canvas.Top="76" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="#BFE6C9" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- ================= 游戏手柄 ================= -->
    <DataTemplate x:Key="ArtGamepad">
        <Viewbox Stretch="Uniform">
            <Canvas Width="200" Height="200">
                <Ellipse Canvas.Left="40" Canvas.Top="132" Width="120" Height="24" Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3A4250" Offset="0" />
                            <GradientStop Color="#003A4250" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 肩键 -->
                <Rectangle Canvas.Left="52" Canvas.Top="62" Width="38" Height="12" RadiusX="6" RadiusY="6" Fill="#DDE2E7" />
                <Rectangle Canvas.Left="110" Canvas.Top="62" Width="38" Height="12" RadiusX="6" RadiusY="6" Fill="#DDE2E7" />

                <!-- 机身 -->
                <Path Data="M62,72 C82,62 118,62 138,72 C152,80 156,96 150,112
                              C144,128 134,144 122,146 C110,148 104,136 100,128
                              C96,136 90,148 78,146 C66,144 56,128 50,112 C44,96 48,80 62,72 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#EDF0F3" Offset="0.6" />
                            <GradientStop Color="#DCE1E6" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Stroke>
                        <SolidColorBrush Color="#CDD3DA" />
                    </Path.Stroke>
                    <Path.StrokeThickness>1.2</Path.StrokeThickness>
                </Path>

                <!-- 左摇杆 -->
                <Ellipse Canvas.Left="64" Canvas.Top="82" Width="22" Height="22" Fill="#C9CFD6" />
                <Ellipse Canvas.Left="67" Canvas.Top="85" Width="16" Height="16" Fill="#5C636C" />

                <!-- 十字键 -->
                <Path Data="M74,112 h6 v6 h6 v6 h-6 v6 h-6 v-6 h-6 v-6 h6 Z" Fill="#9AA2AB" />

                <!-- 右摇杆 -->
                <Ellipse Canvas.Left="112" Canvas.Top="112" Width="22" Height="22" Fill="#C9CFD6" />
                <Ellipse Canvas.Left="115" Canvas.Top="115" Width="16" Height="16" Fill="#5C636C" />

                <!-- 四颗面键 -->
                <Ellipse Canvas.Left="120" Canvas.Top="80" Width="10" Height="10" Fill="#8ED0A8" />
                <Ellipse Canvas.Left="133" Canvas.Top="88" Width="10" Height="10" Fill="#F3B7B1" />
                <Ellipse Canvas.Left="120" Canvas.Top="96" Width="10" Height="10" Fill="#B9D9F3" />
                <Ellipse Canvas.Left="107" Canvas.Top="88" Width="10" Height="10" Fill="#F5E1A4" />

                <!-- 中央指示灯 -->
                <Ellipse Canvas.Left="95" Canvas.Top="74" Width="10" Height="10" Fill="#16A34A" Opacity="0.85" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- ================= 耳机 ================= -->
    <DataTemplate x:Key="ArtHeadset">
        <Viewbox Stretch="Uniform">
            <Canvas Width="200" Height="200">
                <Ellipse Canvas.Left="52" Canvas.Top="150" Width="96" Height="20" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3A4250" Offset="0" />
                            <GradientStop Color="#003A4250" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path Data="M44,124 C44,80 68,52 100,52 C132,52 156,80 156,124"
                      Stroke="#D5DAE0" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M47,120 C47,82 70,57 100,57 C130,57 153,82 153,120"
                      Stroke="#F7F8FA" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <Rectangle Canvas.Left="34" Canvas.Top="110" Width="28" Height="46" RadiusX="13" RadiusY="13"
                           Fill="#FFFFFF" Stroke="#CFD5DC" StrokeThickness="1.2" />
                <Rectangle Canvas.Left="138" Canvas.Top="110" Width="28" Height="46" RadiusX="13" RadiusY="13"
                           Fill="#FFFFFF" Stroke="#CFD5DC" StrokeThickness="1.2" />
                <Rectangle Canvas.Left="40" Canvas.Top="116" Width="16" Height="34" RadiusX="8" RadiusY="8" Fill="#5C636C" />
                <Rectangle Canvas.Left="144" Canvas.Top="116" Width="16" Height="34" RadiusX="8" RadiusY="8" Fill="#5C636C" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- ================= 其他外设 ================= -->
    <DataTemplate x:Key="ArtOther">
        <Viewbox Stretch="Uniform">
            <Canvas Width="200" Height="200">
                <Rectangle Canvas.Left="52" Canvas.Top="56" Width="96" Height="88" RadiusX="18" RadiusY="18">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#E6EAEE" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Stroke>
                        <SolidColorBrush Color="#CFD5DC" />
                    </Rectangle.Stroke>
                    <Rectangle.StrokeThickness>1.2</Rectangle.StrokeThickness>
                </Rectangle>
                <Rectangle Canvas.Left="70" Canvas.Top="86" Width="60" Height="6" RadiusX="3" RadiusY="3" Fill="#16A34A" />
                <Rectangle Canvas.Left="70" Canvas.Top="100" Width="38" Height="6" RadiusX="3" RadiusY="3" Fill="#C9CFD6" />
                <Rectangle Canvas.Left="70" Canvas.Top="114" Width="48" Height="6" RadiusX="3" RadiusY="3" Fill="#C9CFD6" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

</ResourceDictionary>
