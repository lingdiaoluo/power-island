<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorPage">#F4F5F7</Color>
    <Color x:Key="ColorCard">#FFFFFFFF</Color>
    <Color x:Key="ColorSubtle">#F7F8FA</Color>
    <Color x:Key="ColorText">#1F2328</Color>
    <Color x:Key="ColorTextSoft">#8A9099</Color>
    <Color x:Key="ColorHairline">#EBEDF0</Color>
    <Color x:Key="ColorChipBg">#FFFFFFFF</Color>
    <Color x:Key="ColorChipBorder">#E4E7EB</Color>
    <Color x:Key="ColorTrack">#EDEFF2</Color>
    <Color x:Key="ColorHeader">#FBFBFC</Color>

    <SolidColorBrush x:Key="Brush.Page" Color="{StaticResource ColorPage}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="Brush.Subtle" Color="{StaticResource ColorSubtle}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="Brush.TextSoft" Color="{StaticResource ColorTextSoft}" />
    <SolidColorBrush x:Key="Brush.Hairline" Color="{StaticResource ColorHairline}" />
    <SolidColorBrush x:Key="Brush.ChipBg" Color="{StaticResource ColorChipBg}" />
    <SolidColorBrush x:Key="Brush.ChipBorder" Color="{StaticResource ColorChipBorder}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource ColorTrack}" />
    <SolidColorBrush x:Key="Brush.Header" Color="{StaticResource ColorHeader}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E9F7EF" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#F59E0B" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#F0F2F5" />

    <LinearGradientBrush x:Key="Brush.ArtPanel" StartPoint="0.15,0" EndPoint="0.85,1">
        <GradientStop Color="#F7F8FA" Offset="0" />
        <GradientStop Color="#E7EAEF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2BC46B" Offset="0" />
        <GradientStop Color="#12914C" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="2" Direction="270"
                      Color="#101820" Opacity="0.07" />
</ResourceDictionary>
