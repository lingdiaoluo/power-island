<Window x:Class="PowerIsland.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PowerIsland.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="电量岛" Width="940" Height="822" MinWidth="780" MinHeight="640"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStyle="None" Background="{DynamicResource Brush.Page}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:LevelToBrushConverter x:Key="LevelToBrush" />
        <conv:ArtTemplateConverter x:Key="ArtTemplate" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部 ================= -->
        <Grid Grid.Row="0" Margin="26,20,26,4" Background="Transparent"
              MouseLeftButtonDown="OnHeaderDrag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13"
                    Background="{DynamicResource Brush.AccentGradient}" VerticalAlignment="Center">
                <Viewbox Width="24" Height="24">
                    <Path Fill="White" Data="M3,13 L7,13 L7,21 L3,21 Z M9,5 L13,5 L13,21 L9,21 Z M15,9 L19,9 L19,21 L15,21 Z" />
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="电量岛" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.Subtle}" CornerRadius="6" Padding="7,1,7,2"
                            Margin="9,2,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v1.2.0" FontSize="10.5" Foreground="{DynamicResource Brush.TextSoft}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="2.4G 无线设备 · 实时电量" FontSize="12" Margin="1,4,0,0"
                           Foreground="{DynamicResource Brush.TextSoft}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusSummary}" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextSoft}" />
                <Button Style="{StaticResource IconButton}" Click="OnAddDevice" Content="&#xE710;"
                        ToolTip="添加外设" />
                <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="OnToggleTheme"
                        Content="{Binding ThemeGlyph}" ToolTip="切换深浅色" />
                <Button Style="{StaticResource IconButton}" Click="OnRefreshClick" Content="&#xE72C;" ToolTip="立即刷新" />
                <Button Style="{StaticResource IconButton}" Click="OnMinimize" Content="&#xE921;" ToolTip="最小化" />
                <Button Style="{StaticResource IconButton}" Click="OnHideToTray" Content="&#xE8BB;" ToolTip="隐藏到托盘" />
            </StackPanel>
        </Grid>

        <!-- ================= 内容 ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="26,14,20,8">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="276" Margin="0,0,14,14" Padding="16,16,16,14"
                                    Background="{DynamicResource Brush.Card}" CornerRadius="16"
                                    Effect="{DynamicResource CardShadow}">
                                <StackPanel>
                                    <!-- 外观图 -->
                                    <Border Height="150" CornerRadius="12" Background="{DynamicResource Brush.ArtPanel}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ContentControl Content="{Binding ArtKey}"
                                                            ContentTemplate="{Binding ArtKey, Converter={StaticResource ArtTemplate}}"
                                                            Margin="14,6,14,2" />

                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                                    Background="{DynamicResource Brush.Card}" CornerRadius="6"
                                                    Padding="7,2,7,3" Opacity="0.92">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10.5"
                                                           Foreground="{DynamicResource Brush.TextSoft}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 名称 + 百分比 -->
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontSize="19"
                                                   FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Battery, Converter={StaticResource LevelToBrush}}" />
                                    </Grid>

                                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource Brush.TextSoft}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- 读取不到时的提示 -->
                                    <TextBlock Text="{Binding BatteryHintText}"
                                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.TextSoft}"
                                               Visibility="{Binding ShowBatteryHint, Converter={StaticResource BoolToVis}}" />

                                    <!-- 状态 + 电量条 -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Online}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.TextSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.TextSoft}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusHint}" FontSize="11.5"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSoft}" />

                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource BatteryBar}"
                                                     Margin="0,10,0,0" Value="{Binding BarValue, Mode=OneWay}"
                                                     Foreground="{Binding Battery, Converter={StaticResource LevelToBrush}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Brush.Card}" CornerRadius="16" Padding="26,34"
                        Effect="{DynamicResource CardShadow}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="96" Height="72" CornerRadius="12" Background="{DynamicResource Brush.Subtle}">
                            <ContentControl Content="ArtOther"
                                            ContentTemplate="{Binding Source={StaticResource ArtOther}}"
                                            Margin="16,10" />
                        </Border>
                        <TextBlock Text="还没发现可读电量的外设" FontSize="14.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="插上 2.4G 接收器，或让蓝牙外设保持连接后再刷新一次。"
                                   FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSoft}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="立即扫描" Style="{StaticResource GhostButton}" Click="OnRefreshClick" />
                            <Button Content="添加外设" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                                    Click="OnAddDevice" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 设置 -->
                <TextBlock Text="设置" FontSize="15.5" FontWeight="SemiBold" Margin="2,10,0,10" />

                <Border Background="{DynamicResource Brush.Card}" CornerRadius="16" Padding="22,16,22,18"
                        Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="刷新间隔" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Refresh15" Style="{StaticResource Chip}" Content="15 秒" Tag="15"
                                             GroupName="refresh" Click="OnRefreshInterval" />
                                <RadioButton x:Name="Refresh30" Style="{StaticResource Chip}" Content="30 秒" Tag="30"
                                             GroupName="refresh" Click="OnRefreshInterval" />
                                <RadioButton x:Name="Refresh60" Style="{StaticResource Chip}" Content="1 分钟" Tag="60"
                                             GroupName="refresh" Click="OnRefreshInterval" />
                                <RadioButton x:Name="Refresh300" Style="{StaticResource Chip}" Content="5 分钟" Tag="300"
                                             GroupName="refresh" Click="OnRefreshInterval" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="开机自启" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AutoStartOn" Style="{StaticResource Chip}" Content="开"
                                             GroupName="autostart" Click="OnAutoStart" />
                                <RadioButton x:Name="AutoStartOff" Style="{StaticResource Chip}" Content="关"
                                             GroupName="autostart" Click="OnAutoStart" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="低电量阈值" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Low10" Style="{StaticResource Chip}" Content="10%" Tag="10"
                                             GroupName="low" Click="OnLowThreshold" />
                                <RadioButton x:Name="Low20" Style="{StaticResource Chip}" Content="20%" Tag="20"
                                             GroupName="low" Click="OnLowThreshold" />
                                <RadioButton x:Name="Low30" Style="{StaticResource Chip}" Content="30%" Tag="30"
                                             GroupName="low" Click="OnLowThreshold" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="低电量提醒" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NotifyOn" Style="{StaticResource Chip}" Content="开"
                                             GroupName="notify" Click="OnLowNotify" />
                                <RadioButton x:Name="NotifyOff" Style="{StaticResource Chip}" Content="关"
                                             GroupName="notify" Click="OnLowNotify" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="托盘显示电量数字" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TrayNumOn" Style="{StaticResource Chip}" Content="显示"
                                             GroupName="traynum" Click="OnTrayNumber" />
                                <RadioButton x:Name="TrayNumOff" Style="{StaticResource Chip}" Content="不显示"
                                             GroupName="traynum" Click="OnTrayNumber" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="显示无电量设备" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="UnknownOn" Style="{StaticResource Chip}" Content="显示"
                                             GroupName="unknown" Click="OnShowUnknown" />
                                <RadioButton x:Name="UnknownOff" Style="{StaticResource Chip}" Content="隐藏"
                                             GroupName="unknown" Click="OnShowUnknown" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 外设设置 -->
                <TextBlock Text="外设设置 · DPI 与回报率" FontSize="15.5" FontWeight="SemiBold" Margin="2,16,0,10" />

                <Border Background="{DynamicResource Brush.Card}" CornerRadius="16" Padding="22,14,22,14"
                        Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="DPI 档位" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal" IsEnabled="False">
                                <RadioButton Style="{StaticResource Chip}" Content="800" GroupName="dpi" />
                                <RadioButton Style="{StaticResource Chip}" Content="1200" GroupName="dpi" />
                                <RadioButton Style="{StaticResource Chip}" Content="1600" IsChecked="True" GroupName="dpi" />
                                <RadioButton Style="{StaticResource Chip}" Content="2000" GroupName="dpi" />
                                <RadioButton Style="{StaticResource Chip}" Content="2600" GroupName="dpi" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="回报率" Width="112" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <StackPanel Orientation="Horizontal" IsEnabled="False">
                                <RadioButton Style="{StaticResource Chip}" Content="125 Hz" GroupName="hz" />
                                <RadioButton Style="{StaticResource Chip}" Content="250 Hz" GroupName="hz" />
                                <RadioButton Style="{StaticResource Chip}" Content="500 Hz" IsChecked="True" GroupName="hz" />
                                <RadioButton Style="{StaticResource Chip}" Content="1000 Hz" GroupName="hz" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="这些参数由设备固件持有，需要 VGN HUB 等官方驱动写入。电量岛只读取电量，不会改动你的设置。"
                                   FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSoft}" />
                    </StackPanel>
                </Border>

                <Border Height="14" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================= 底部 ================= -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Header}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="立即刷新" Style="{StaticResource AccentButton}" Click="OnRefreshClick" />
                    <Button Content="添加外设" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Click="OnAddDevice" />
                    <Button Content="打开配置目录" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Click="OnOpenConfigFolder" />
                </StackPanel>
                <TextBlock Text="{Binding LastUpdatedText}" FontSize="11.5" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSoft}" />
            </Grid>
        </Border>
    </Grid>
</Window>
