<Window x:Class="PowerIsland.Views.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PowerIsland.Converters"
        Title="电量" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" Focusable="False" IsHitTestVisible="True">

    <Window.Resources>
        <conv:LevelToBrushConverter x:Key="LevelToBrush" />
    </Window.Resources>

    <Border Background="#F22C3037" CornerRadius="10" BorderBrush="#4A5058" BorderThickness="1"
            Padding="13,10" MinWidth="152">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.45" />
        </Border.Effect>

        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TrayName}" FontSize="12.5"
                                   FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#DDE1E6"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontSize="12.5" FontWeight="Bold"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   Foreground="{Binding Battery, Converter={StaticResource LevelToBrush}, ConverterParameter=tray}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
